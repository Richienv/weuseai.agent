<?xml version="1.0" encoding="UTF-8"?>
<!--
  Persona pages are listed as /persona?slug=<slug> because that is the form
  that actually answers 200 in production. The pretty path /persona/<slug>
  is declared in vercel.json but currently returns 404 on the live
  deployment (every dynamic-segment rewrite does, e.g. /admin/customers/:id),
  so it is deliberately kept out of this file — a sitemap with dead URLs
  costs crawler trust. Swap these to /persona/<slug> once that rewrite
  answers 200.
-->
