{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/liren-v3", "destination": "/", "permanent": true },
    { "source": "/liren-v3.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*\\.mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*\\.(png|jpg|jpeg|gif|svg|webp|ico|woff2|woff|ttf))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/nightly-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
