{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/admin/observability/cost",
      "destination": "/api/admin/observability?report=cost"
    },
    {
      "source": "/api/admin/observability/customer",
      "destination": "/api/admin/observability?report=customer"
    },
    {
      "source": "/api/admin/observability/fleet-summary",
      "destination": "/api/admin/observability?report=fleet-summary"
    },
    {
      "source": "/api/admin/observability/template-no-match",
      "destination": "/api/admin/observability?report=template-no-match"
    },
    {
      "source": "/api/admin/library-proposal-decide",
      "destination": "/api/admin/library-proposals"
    },
    {
      "source": "/ai-video",
      "destination": "/ai-video.html"
    },
    {
      "source": "/persona/:slug",
      "destination": "/persona.html?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/manual-provision",
      "destination": "/admin/manual-provision.html"
    },
    {
      "source": "/admin/customers",
      "destination": "/admin/customers.html"
    },
    {
      "source": "/admin/customers/:id",
      "destination": "/admin/customer-detail.html?id=:id"
    },
    {
      "source": "/admin/fleet",
      "destination": "/admin/fleet.html"
    },
    {
      "source": "/admin/cost",
      "destination": "/admin/cost.html"
    },
    {
      "source": "/admin/templates",
      "destination": "/admin/templates.html"
    },
    {
      "source": "/admin/proposals",
      "destination": "/admin/proposals.html"
    },
    {
      "source": "/admin/ai-video",
      "destination": "/admin/ai-video.html"
    }
  ],
  "redirects": [
    {
      "source": "/liren-v3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/liren-v3.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privasi",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privasi.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/syarat",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/syarat.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/kontak",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/kontak.html",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/checkout",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ai-video",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ai-video/checkout",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ai-video/welcome",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },

    {
      "source": "/checkout-new",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/welcome",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/onboarding",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/chat",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/faq",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/use-cases",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/refund-policy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/persona/:slug",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/vendor/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/:path*.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/:path*.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/:path*.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/:path*.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:path*.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:path*.jpeg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:path*.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:path*.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/nightly-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/flow-state-ttl-sweep",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/flow-paused-nudge",
      "schedule": "0 20 * * *"
    }
  ]
}
