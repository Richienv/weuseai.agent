# Supabase Edge Functions local-dev env (founder local-first directive 2026-05-14).
# Setup:
#   cp supabase/.env.example supabase/.env.local
#   supabase start                        # then `supabase status` prints keys
#   # paste the printed sb_secret_... and sb_publishable_... below
#   npm run local:fn-serve
#
# DO NOT commit real Supabase keys to this .env.example file — GitHub's
# secret scanner blocks pushes that match `sb_secret_*` / `sb_publishable_*`
# patterns, even local-dev defaults. Use placeholder text here; real
# values live only in supabase/.env.local (gitignored).
#
# Production Edge Function secrets live on the Supabase project dashboard
# and are picked up by `supabase functions deploy` from there, not from
# this file.

# Local Supabase API base + service-role + anon key.
# Run `supabase status` after `supabase start` and paste the live values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<paste-sb_secret-from-supabase-status>
SUPABASE_ANON_KEY=<paste-sb_publishable-from-supabase-status>

# Xendit — TEST mode for local + Phase F (founder lock-in 2026-05-14)
# A future agent reading this: rotate to xnd_production_* ONLY after
# the cascade unlocks per feedback_8min_flow_priority_lock.md.
XENDIT_API_KEY=xnd_development_test_local_stub
XENDIT_WEBHOOK_TOKEN=local-test-webhook-token

# Provisioning service — for local Edge Function → local Fly stub.
# host.docker.internal lets the Edge Function container reach a
# provisioning service running on the macOS host at :8080.
PROVISIONING_URL=http://host.docker.internal:8080
PROVISIONING_AUTH_TOKEN=local-test-prov-token

# Bot-token encryption (32 bytes base64). Sample value below is all-zero
# placeholder — fine for local where customers.telegram_bot_token is null.
BOT_TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Telegram founder DM (Phase 4 retry-worker alert pattern). Leave empty
# to no-op locally — the script gracefully handles missing token.
SUPPORT_TELEGRAM_BOT_TOKEN=
RICHIE_CHAT_ID=6805409051
