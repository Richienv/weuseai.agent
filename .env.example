# ──────────────────────────────────────────────────────────
# Liren Stand — environment variables
# Copy ke .env (atau per-package .env) dan isi
# ──────────────────────────────────────────────────────────

# IDCloudHost (VPS provider)
IDCLOUDHOST_API_KEY=
IDCLOUDHOST_BILLING_ACCOUNT_ID=
IDCLOUDHOST_SSH_KEY_UUID=             # uuid dari /v1/user-resource/ssh_keys

# LLM providers
ZHIPU_API_KEY=                        # GLM-4-Flash (gratis)
DEEPSEEK_API_KEY=                     # overflow LLM
ANTHROPIC_API_KEY=                    # opsional, premium tier

# Telegram
TELEGRAM_BOT_TOKEN=                   # @LirenStandBot
RICHIE_CHAT_ID=                       # untuk error alerts

# Xendit (payment)
XENDIT_SECRET_KEY=                    # production: xnd_...
XENDIT_WEBHOOK_TOKEN=                 # untuk verify callback

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # untuk webhook handlers (server-side)

# Provisioning service
PROVISIONING_AUTH_TOKEN=              # bearer token untuk webhook → provisioning call
PROVISIONING_URL=http://localhost:8080

# LLM proxy (Cloudflare Worker)
PROXY_URL=https://proxy.lirenlabs.ai
PROXY_JWT_SECRET=                     # untuk sign customer tokens
