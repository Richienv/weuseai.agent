# ──────────────────────────────────────────────────────────
# weuseai-provisioning — environment variables
# Production: set via `fly secrets set …` (NOT committed).
# Local dev: copy to .env and fill.
# ──────────────────────────────────────────────────────────

# Service auth (bearer token the Edge Function presents on /spin-up etc.)
PROVISIONING_AUTH_TOKEN=

# VPS provider routing (Vultr primary since 2026-05-11; DO failover)
VPS_PROVIDER=vultr                      # 'vultr' | 'digitalocean' | 'mock'
VULTR_API_KEY=
VULTR_REGION=sgp
VULTR_FLEET_SSH_KEY_ID=
DIGITALOCEAN_API_KEY=
DIGITALOCEAN_REGION=sgp1
DIGITALOCEAN_FLEET_SSH_KEY_ID=

# Fleet SSH (re-SSH into customer VPSes for tier-bump / refresh-env)
FLEET_SSH_PRIVATE_KEY=
FLEET_SSH_PUBKEY=

# Telegram (provisioning alerts + halo proof-of-life)
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_CHAT_ID=
RICHIE_CHAT_ID=                         # provisioning error alerts

# Supabase (refresh-env store, second-finisher notify)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hermes version pin (default v0.13.0 in setup-script.ts; override to test
# a new upstream tag on the next-provisioned VPS).
HERMES_VERSION=

# Phase 5-3.c: per-customer HMAC token signing (optional).
HERMES_INSTANCE_HMAC_KEY=

# ── Phase B: native Hermes voice-input (STT) ──────────────────────────
# STT provider key for Hermes' native voice-memo transcription on
# voice-tier customer VPSes (voice-starter / library-full / done-for-you /
# enterprise — all grant features.voice). Single fleet-wide secret; Hermes
# calls the STT provider internally with it on each customer VPS.
#
# Default provider is Groq (free + fast + good Bahasa) — set VOICE_STT_GROQ_KEY.
# To switch the fleet to OpenAI Whisper, flip VOICE_STT_PROVIDER in
# setup-script.ts AND set VOICE_STT_OPENAI_KEY to a REAL api.openai.com key
# (NOT an OpenRouter key — Hermes' OpenAI STT reads VOICE_TOOLS_OPENAI_KEY,
# distinct from the OPENAI_API_KEY chat var that already holds the
# OpenRouter sub-key).
#
# Absent → voice-tier VPSes still get the voice/stt config block (so STT
# activates the moment a key lands via refresh-env), but the key env line is
# omitted and incoming voice stays untranscribed. Text chat is unaffected.
VOICE_STT_GROQ_KEY=                     # get one free at console.groq.com/keys
VOICE_STT_OPENAI_KEY=                   # only if fleet switched to OpenAI provider
